{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zipkoo",
  "version": "0.1.0",
  "identifier": "app.zipkoo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zipkoo",
        "width": 1180,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app"
    ],
    "category": "Utility",
    "shortDescription": "Zip it. Ship it.",
    "longDescription": "Zipkoo packs, opens and safely shares archives on Windows and Mac.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "zip",
          "zipx"
        ],
        "name": "ZIP archive",
        "role": "Editor"
      },
      {
        "ext": [
          "7z"
        ],
        "name": "7z archive",
        "role": "Editor"
      },
      {
        "ext": [
          "rar"
        ],
        "name": "RAR archive",
        "role": "Viewer"
      },
      {
        "ext": [
          "tar",
          "gz",
          "tgz",
          "zst",
          "tzst",
          "bz2",
          "tbz2",
          "xz",
          "txz"
        ],
        "name": "Compressed archive",
        "role": "Viewer"
      },
      {
        "ext": [
          "iso",
          "cab",
          "lzh",
          "lha"
        ],
        "name": "Disc image or archive",
        "role": "Viewer"
      },
      {
        "ext": [
          "001"
        ],
        "name": "Split archive part",
        "role": "Viewer"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "mainBinaryName": "Zipkoo",
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/hridoycraftt/Zipkoo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
